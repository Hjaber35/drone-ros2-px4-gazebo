<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="simple_rover">
    <pose>0 0 0.15 0 0 0</pose>

    <link name="base_link">
      <pose>0 0 0.15 0 0 0</pose>

      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.2</ixx>
          <iyy>0.2</iyy>
          <izz>0.2</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.7 0.45 0.18</size>
          </box>
        </geometry>
      </collision>
      <!-- Front support to prevent the chassis tipping forward. -->
      <collision name="front_support_collision">
        <pose>0.28 0 -0.10 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.05</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.0</mu>
              <mu2>0.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- Rear support to prevent the chassis tipping backward. -->
      <collision name="rear_support_collision">
        <pose>-0.28 0 -0.10 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.05</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.0</mu>
              <mu2>0.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

            <!-- Blue chassis -->
      <visual name="base_visual">
        <geometry>
          <box>
            <size>0.7 0.45 0.18</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.3 0.8 1</ambient>
          <diffuse>0.05 0.3 0.8 1</diffuse>
        </material>
      </visual>

      <!-- Yellow stripe on top, near the front (+X) -->
      <visual name="front_stripe">
        <pose>0.25 0 0.095 0 0 0</pose>
        <geometry>
          <box>
            <size>0.12 0.4 0.01</size>
          </box>
        </geometry>
        <material>
          <ambient>1 0.8 0.05 1</ambient>
          <diffuse>1 0.8 0.05 1</diffuse>
        </material>
      </visual>
      <!-- Horizontal LiDAR mounted above the chassis -->
      <sensor name="rover_lidar" type="gpu_lidar">
        <pose>0 0 0.20 0 0 0</pose>
        <topic>/scan</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>

        <lidar>
          <scan>
            <horizontal>
              <samples>1081</samples>
              <resolution>1</resolution>
              <min_angle>-3.141593</min_angle>
              <max_angle>3.141593</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.10</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </link>

    <link name="left_wheel">
      <pose>0 0.28 0.12 1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="left_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="left_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </visual>
    </link>

    <link name="right_wheel">
      <pose>0 -0.28 0.12 1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="right_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="right_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </visual>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">

      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>0.56</wheel_separation>
      <wheel_radius>0.12</wheel_radius>

      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/model/simple_rover/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>

  </model>
</sdf>