<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="simple_room">

    <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397742</latitude_deg>
      <longitude_deg>8.545594</longitude_deg>
      <elevation>488.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <plugin
      filename="gz-sim-air-pressure-system"
      name="gz::sim::systems::AirPressure">
    </plugin>

    <plugin
      filename="gz-sim-magnetometer-system"
      name="gz::sim::systems::Magnetometer">
    </plugin>

    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.8 1.0 1</background>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry>
            <box>
              <size>12 12 0.1</size>
            </box>
          </geometry>
        </collision>

        <visual name="floor_visual">
          <geometry>
            <box>
              <size>12 12 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_front">
      <static>true</static>
      <pose>0 6 1 0 0 0</pose>
      <link name="wall_front_link">
        <collision name="wall_front_collision">
          <geometry>
            <box>
              <size>12 0.2 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_front_visual">
          <geometry>
            <box>
              <size>12 0.2 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_back">
      <static>true</static>
      <pose>0 -6 1 0 0 0</pose>
      <link name="wall_back_link">
        <collision name="wall_back_collision">
          <geometry>
            <box>
              <size>12 0.2 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_back_visual">
          <geometry>
            <box>
              <size>12 0.2 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_left">
      <static>true</static>
      <pose>-6 0 1 0 0 0</pose>
      <link name="wall_left_link">
        <collision name="wall_left_collision">
          <geometry>
            <box>
              <size>0.2 12 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_left_visual">
          <geometry>
            <box>
              <size>0.2 12 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_right">
      <static>true</static>
      <pose>6 0 1 0 0 0</pose>
      <link name="wall_right_link">
        <collision name="wall_right_collision">
          <geometry>
            <box>
              <size>0.2 12 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_right_visual">
          <geometry>
            <box>
              <size>0.2 12 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="center_obstacle">
      <static>true</static>
      <pose>1 1 0.5 0 0 0</pose>
      <link name="center_obstacle_link">
        <collision name="center_obstacle_collision">
          <geometry>
            <box>
              <size>0.5 0.5 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="center_obstacle_visual">
          <geometry>
            <box>
              <size>0.5 0.5 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.8 1</ambient>
            <diffuse>0.2 0.2 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
<include>
  <uri>model://simple_rover</uri>
  <pose>0 0 0.06 0 0 0</pose>
</include>
    <!-- Green target area at x=2, y=2 -->
    <model name="target_marker">
      <static>true</static>
      <pose>2 2 0.065 0 0 0</pose>

      <link name="marker_link">
        <visual name="marker_visual">
          <geometry>
            <cylinder>
              <radius>0.35</radius>
              <length>0.02</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>0.1 0.9 0.2 1</ambient>
            <diffuse>0.1 0.9 0.2 1</diffuse>
            <emissive>0.02 0.2 0.04 1</emissive>
          </material>
        </visual>
      </link>
    </model>
    <!-- Extra obstacle to test choosing the right-hand detour -->
    <model name="left_detour_blocker">
      <static>true</static>
      <pose>-0.3 1.2 0.5 0 0 0</pose>

      <link name="blocker_link">
        <collision name="blocker_collision">
          <geometry>
            <box>
              <size>0.5 0.5 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="blocker_visual">
          <geometry>
            <box>
              <size>0.5 0.5 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.3 0.1 1</ambient>
            <diffuse>0.9 0.3 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>